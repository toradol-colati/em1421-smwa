  classDef step fill:#DCEBFA,stroke:#3A78B5,color:#10324F
  classDef chk fill:#FBE3C9,stroke:#C9781E,color:#4A2A05
  classDef out fill:#DDF2DD,stroke:#3C8D3C,color:#123812
  classDef grp fill:#FFFFFF,stroke:#999,color:#222
