# macOS
.DS_Store

# R
.Rhistory
.RData
.Rproj.user/
*.Rproj
.Renviron

# data/ is deliberately NOT ignored: the submission requires the data together
# with the code (instructions, section 5).

# Generated data and analysis outputs are recreated by the scripts and are not
# committed. Keep only the directory documentation.
data/processed/*
!data/processed/.gitkeep
!data/processed/README.md

output/figures/*
!output/figures/.gitkeep

output/results/*
!output/results/.gitkeep
